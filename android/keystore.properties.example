# Copy this file to android/keystore.properties (gitignored) and fill in real values.
# Do not commit android/keystore.properties or any .jks / .keystore file.
#
# storeFile must be an absolute path to a keystore kept outside this repo.
# Forward slashes work on Windows, e.g. C:/Users/YOU/keys/rdr2-guide.jks

storeFile=C:/Users/YOU/keys/your-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=rdr2guide
keyPassword=YOUR_KEY_PASSWORD
